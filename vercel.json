{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/socket.io/(.*)", "destination": "https://api.disheera.site/socket.io/$1" },
    { "source": "/socket.io", "destination": "https://api.disheera.site/socket.io" },
    { "source": "/api/interview/(.*)", "destination": "https://api.disheera.site/api/interview/$1" },
    { "source": "/api/interview", "destination": "https://api.disheera.site/api/interview" },
    { "source": "/api/projects/submit", "destination": "https://api.disheera.site/api/projects/submit" },
    { "source": "/api/projects/verify(.*)", "destination": "https://api.disheera.site/api/projects/verify$1" },
    { "source": "/api/projects/(.*)/evaluate", "destination": "https://api.disheera.site/api/projects/$1/evaluate" },
    { "source": "/api/resume/analyze", "destination": "https://api.disheera.site/api/resume/analyze" },
    { "source": "/api/resume/upload(.*)", "destination": "https://api.disheera.site/api/resume/upload$1" },
    { "source": "/api/resume/improve-text", "destination": "https://api.disheera.site/api/resume/improve-text" },
    { "source": "/api/resume/match-job", "destination": "https://api.disheera.site/api/resume/match-job" },
    { "source": "/api/assignments/template", "destination": "https://api.disheera.site/api/assignments/template" },
    { "source": "/api/assignments/download-batch(.*)", "destination": "https://api.disheera.site/api/assignments/download-batch$1" },
    { "source": "/api/assignments/(.*)/evaluate", "destination": "https://api.disheera.site/api/assignments/$1/evaluate" },
    { "source": "/api/assignments/eval-sheet/(.*)", "destination": "https://api.disheera.site/api/assignments/eval-sheet/$1" },
    { "source": "/api/assignments/download/(.*)", "destination": "https://api.disheera.site/api/assignments/download/$1" },
    { "source": "/api/whatsapp/(.*)", "destination": "https://api.disheera.site/api/whatsapp/$1" },
    { "source": "/api/whatsapp", "destination": "https://api.disheera.site/api/whatsapp" },
    { "source": "/api/campus/export-batch(.*)", "destination": "https://api.disheera.site/api/campus/export-batch$1" },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "apivercel.disheera.site" }],
      "destination": "/api"
    },
    { "source": "/api/(.*)", "destination": "https://api.disheera.site/api/$1" },
    { "source": "/api", "destination": "https://api.disheera.site/api" },
    { "source": "/.well-known/(.*)", "destination": "/client/.well-known/$1" },
    { "source": "/mcp-actions.json", "destination": "/client/mcp-actions.json" },
    { "source": "/llms.txt", "destination": "/client/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/client/llms-full.txt" },
    { "source": "/robots.txt", "destination": "/client/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/client/sitemap.xml" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(self)" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|webp|woff2|woff|ttf|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/client/(.*)\\.(css|js|png|jpg|jpeg|svg|webp|woff2|woff|ttf|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
