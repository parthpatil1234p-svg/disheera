# ============================================================
# CareerPath AI — Root .gitignore
# ============================================================

# Node modules (backend)
server/node_modules/

# Environment variables — NEVER commit these
server/.env
.env

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Build outputs
dist/
build/
