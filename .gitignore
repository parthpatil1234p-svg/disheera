# ============================================================
# CareerPath AI — Root .gitignore
# ============================================================

# Node modules
node_modules/
server/node_modules/

# Environment variables — NEVER commit these
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Deployment outputs & cache
.vercel
dist/
build/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
