// ============================================================
// Disheera — Supabase (PostgreSQL) Prisma Schema
// Enterprise Architecture · Disheera Technologies Inc.
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

generator rootClient {
  provider      = "prisma-client-js"
  output        = "../../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── 1. User Model ─────────────────────────────────────────────
model User {
  id                            String    @id
  name                          String
  email                         String    @unique
  password                      String?
  googleId                      String?
  githubId                      String?
  authProvider                  String    @default("local")
  role                          String    @default("student")
  primaryStream                 String    @default("engineering")
  avatarUrl                     String?
  resumeUrl                     String?
  profileCompleted              Boolean   @default(false)
  isVerified                    Boolean   @default(false)
  hasCompletedSkillVerification Boolean   @default(false)
  phone                         String?   @default("")
  whatsappNotificationsEnabled  Boolean   @default(true)
  lastAbandonedRouteAt          DateTime?

  // JSONB Document Fields
  education                     Json?
  interests                     Json?
  skills                        Json?
  careerGoals                   Json?
  githubProfile                 Json?
  githubRepos                   Json?
  recruiterProfile              Json?
  resumeRecord                  Json?
  completedPaths                Json?
  profileStatus                 Json?
  resumeAnalysis                Json?
  mockInterview                 Json?
  jobReadiness                  Json?
  builtResume                   Json?
  verificationOtp               Json?
  encryptedVault                Json?
  collegeId                     String?
  tpoProfile                    Json?

  // Relations
  roadmaps                      Roadmap[]
  attempts                      Attempt[]
  resume                        Resume?
  jobOpenings                   JobOpening[]
  studentApplications           JobApplication[] @relation("StudentApplications")
  recruiterApplications         JobApplication[] @relation("RecruiterApplications")
  assignmentSubmissions         AssignmentSubmission[]
  meritScore                    StudentMeritScore?
  college                       College?  @relation("CollegeStudents", fields: [collegeId], references: [id])
  managedCollege                College?  @relation("CollegeTpo")

  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([role])
  @@index([googleId])
  @@index([githubId])
  @@index([collegeId])
}

// ── 2. Roadmap Model ──────────────────────────────────────────
model Roadmap {
  id                 String        @id
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId           String
  career             Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)
  durationWeeks      Int           @default(4)
  status             String        @default("active") // "active", "completed", "abandoned"
  abandonedAt        DateTime?
  totalTasks         Int           @default(0)
  completedTasks     Int           @default(0)
  progressPercentage Float         @default(0)
  startedAt          DateTime      @default(now())
  completedAt        DateTime?

  // JSONB Document Fields
  careerSnapshot     Json?
  generatedFrom      Json?
  weekProgress       Json?

  // Relations
  tasks              RoadmapTask[]
  attempts           Attempt[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([careerId])
  @@index([status])
  @@index([userId, status, createdAt(sort: Desc)], map: "idx_roadmap_user_status_created")
}

// ── 3. RoadmapTask Model ──────────────────────────────────────
model RoadmapTask {
  id                     String    @id
  roadmapId              String
  roadmap                Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weekNumber             Int
  order                  Int
  title                  String
  description            String
  type                   String    @default("learn") // "learn", "practice", "project", "quiz"
  skillName              String?
  priority               String    @default("medium")
  estimatedHours         Int       @default(2)
  completed              Boolean   @default(false)
  completedAt            DateTime?
  isVideoTask            Boolean   @default(false)
  videoWatchTimeSeconds  Int       @default(0)
  videoDurationSeconds   Int       @default(0)
  videoMaxWatchedTime    Int       @default(0)
  videoMidCheckPassed    Boolean   @default(false)
  isVideoVerified        Boolean   @default(false)
  videoVerifiedAt        DateTime?
  videoAiScore           Float?
  videoAiFeedback        String?
  videoReflectionSummary String?
  projectVerifiedAt      DateTime?
  projectVerification    Json?

  // JSONB Document Fields
  resource               Json?
  videoVerification      Json?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([roadmapId])
  @@index([weekNumber])
  @@index([completed])
  @@index([roadmapId, weekNumber, order], map: "idx_roadmaptask_roadmap_week_order")
  @@index([roadmapId, completed, weekNumber, order], map: "idx_roadmaptask_roadmap_completed_week_order")
}

// ── 4. Career Model ───────────────────────────────────────────
model Career {
  id                   String    @id
  title                String    @unique
  slug                 String    @unique
  shortDescription     String
  longDescription      String
  category             String
  icon                 String?
  color                String?
  active               Boolean   @default(true)

  // JSONB Document Fields
  educationPreferences Json?
  interestTags         Json?
  requiredSkills       Json?

  // Relations
  roadmaps             Roadmap[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ── 5. Skill Model (Enhanced with Lightcast Open Skills Taxonomy) ──
model Skill {
  id            String    @id @default(uuid())
  lightcastId   String?   @unique
  name          String    @unique
  displayName   String
  type          String    @default("specialized") // specialized | software | common
  category      String
  subcategory   String?
  aliases       Json?     @default("[]")
  description   String?   @db.Text
  active        Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
}

// ── 6. Attempt Model ──────────────────────────────────────────
model Attempt {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String    // "skill_check" or "weekly_test"
  skill             String?
  roadmapId         String?
  roadmap           Roadmap?  @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  roadmapWeek       Int?
  score             Float
  total             Int
  percent           Float
  passed            Boolean   @default(false)
  startTime         DateTime
  deadline          DateTime
  submitTime        DateTime?

  // JSONB Document Fields
  topicTags         Json?
  questionsAsked    Json?
  missedTopics      Json?
  integrityMetadata Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([type])
  @@index([roadmapId])
  @@index([userId, roadmapId, roadmapWeek, createdAt(sort: Desc)], map: "idx_attempt_user_roadmap_week_created")
  @@index([createdAt(sort: Desc)], map: "idx_attempt_created_at")
}

// ── 7. Resume Model ───────────────────────────────────────────
model Resume {
  id               String   @id
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName     String
  fileType         String
  sizeBytes        Int
  fileLocation     String
  publicId         String
  version          Int      @default(1)
  extractedText    String?
  atsScore         Float?
  firstUploadedAt  DateTime
  lastUpdatedAt    DateTime

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── 8. Company Model ──────────────────────────────────────────
model Company {
  id                  String       @id
  name                String
  domain              String       @unique
  website             String?
  logoUrl             String?
  industry            String?
  headquarters        String?
  companySize         String?
  cinNumber           String?
  linkedinUrl         String?
  isVerified          Boolean      @default(false)
  verificationScore   Float        @default(0)

  // JSONB Document Fields
  verificationDetails Json?

  // Relations
  jobOpenings         JobOpening[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// ── 9. JobOpening Model ───────────────────────────────────────
model JobOpening {
  id                   String           @id
  recruiterId          String
  recruiter            User             @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName          String
  companyLogo          String?
  companyWebsite       String?
  isCompanyVerified    Boolean          @default(true)
  title                String
  careerSlug           String
  jobType              String
  workplace            String
  location             String?
  experienceLevel      String?
  salaryMin            Float?
  salaryMax            Float?
  salaryCurrency       String?
  description          String
  minimumReadinessScore Float?
  status               String           @default("active")
  applicationsCount    Int              @default(0)
  deadline             DateTime?

  // JSONB Document Fields
  responsibilities     Json?
  requiredSkills       Json?

  // Relations
  applications         JobApplication[]

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([recruiterId])
  @@index([companyId])
  @@index([status])
  @@index([recruiterId, createdAt(sort: Desc)], map: "idx_jobopening_recruiter_created")
}

// ── 10. JobApplication Model ──────────────────────────────────
model JobApplication {
  id                  String     @id
  jobId               String
  job                 JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId           String
  student             User       @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Cascade)
  recruiterId         String
  recruiter           User       @relation("RecruiterApplications", fields: [recruiterId], references: [id], onDelete: Cascade)
  matchScore          Float
  readinessTier       String?
  resumeUrl           String?
  coverNote           String?
  status              String     @default("applied")
  recruiterNotes      String?
  appliedAt           DateTime   @default(now())

  // JSONB Document Fields
  matchedSkills       Json?
  missingSkills       Json?
  builtResumeSnapshot Json?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([jobId, studentId])
  @@index([studentId])
  @@index([recruiterId])
  @@index([status])
}

// ── 11. YoutubeCache Model ────────────────────────────────────
model YoutubeCache {
  id        String   @id
  queryKey  String   @unique
  skillName String?
  source    String   @default("curated_registry")

  // JSONB Document Fields
  videos    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 12. CampusLead Model ──────────────────────────────────────
model CampusLead {
  id                String    @id
  collegeName       String
  cityState         String?
  contactPerson     String
  designation       String
  email             String
  phone             String
  batchSize         String
  preferredDemoDate DateTime?
  source            String
  voiceAiCallId     String?
  status            String    @default("new")
  notes             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ── 13. Admin Management Models ────────────────────────────────
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

model AdminUser {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  password            String             // bcrypt cost 12
  role                AdminRole          @default(MODERATOR)
  mustChangePassword  Boolean            @default(true)
  totpSecret          String?
  totpEnabled         Boolean            @default(false)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  isActive            Boolean            @default(true)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  auditLogs           AdminAuditLog[]
  sessions            AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid())
  adminId   String
  tokenHash String    @unique            // SHA-256 of JWT for instant revocation
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id         String     @id @default(uuid())
  adminId    String
  adminEmail String
  action     String     // e.g., "USER_SUSPEND", "RECRUITER_VERIFY", "PASSPORT_REVOKE", "VIDEO_ADD", "RADAR_UPDATE", "PASSWORD_CHANGE"
  targetType String     // "USER", "RECRUITER", "PASSPORT", "COURSE", "RADAR", "SYSTEM", "AUTH"
  targetId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  admin      AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model AdminLoginAttempt {
  id          String    @id @default(uuid())
  email       String
  ipAddress   String
  success     Boolean
  reason      String?   // "INVALID_CREDENTIALS", "ACCOUNT_LOCKED", "INACTIVE_ACCOUNT", "PASSWORD_CHANGE_REQUIRED"
  attemptedAt DateTime  @default(now())

  @@index([email])
  @@map("admin_login_attempts")
}

// ── 17. RadarEmployer Model (Industrial Proximity Radar) ──────
model RadarEmployer {
  id                 String   @id
  name               String
  cluster            String
  clusterGroup       String?
  city               String
  state              String
  latitude           Float
  longitude          Float
  distanceKm         Float?   @default(0)
  industry           String
  website            String?  @default("")
  openingsCount      Int      @default(0)
  topRoles           Json?    @default("[]")
  requiredSkills     Json?    @default("[]")
  verifiedPartner    Boolean  @default(false)
  hiringFresher      Boolean  @default(true)
  internshipOffered  Boolean  @default(false)
  campusDriveActive  Boolean  @default(false)
  isBaseEmployer     Boolean  @default(false)
  isActive           Boolean  @default(true)
  addedBy            String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("radar_employers")
}

// ── 18. PendingSignup Model (Outside-User-Table Signups) ──────
model PendingSignup {
  id               String    @id
  email            String    @unique
  name             String
  passwordHash     String
  phone            String?
  role             String    @default("student")
  emailOtpHash     String
  whatsappOtpHash  String?
  backupOtp        String?
  recruiterProfile Json?
  expiresAt        DateTime
  attempts         Int       @default(0)
  sendHistory      Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("pending_signups")
}
// ── 19. Weekly Assignments & Multimodal Grading Suite (Plan 46) ──
enum SubmissionStatus {
  SUBMITTED
  EVALUATING
  GRADED
  FLAGGED_AI
  RESUBMISSION_REQUESTED
  ADMIN_APPROVED
}

model WeeklyAssignment {
  id               String                 @id @default(uuid())
  careerId         String
  weekNumber       Int
  title            String
  description      String
  maxMarks         Int                    @default(10)
  learningOutcomes Json?                  // Array of concepts covered in that week
  questions        Json                   // Array of college-style questions/problems
  rubric           Json                   // 4D evaluation rubric criteria
  templatePdfUrl   String?                // Downloadable Cover Sheet template
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  submissions      AssignmentSubmission[]

  @@unique([careerId, weekNumber])
  @@map("weekly_assignments")
}

model AssignmentSubmission {
  id                   String           @id @default(uuid())
  assignmentId         String
  assignment           WeeklyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId            String
  weekNumber           Int
  pdfUrl               String           // Stored assignment PDF path/URL or base64 reference
  fileSizeBytes        Int
  pageCount            Int              @default(1)
  status               SubmissionStatus @default(SUBMITTED)

  // Dual Evaluation: AI Evaluation & Anti-AI Signals
  aiScore              Float?           // AI provisional score (0-10)
  aiFeedback           String?          @db.Text
  aiRubricBreakdown    Json?            // { problemSolving: 4, methodology: 3, clarity: 2.5 }
  aiProbability        Float            @default(0.0) // 0.0 to 1.0 (e.g., 0.85 = 85% AI)
  aiDetected           Boolean          @default(false)
  aiDetectionReasons   Json?            // Array of specific flags detected
  aiEvaluatedAt        DateTime?

  // Dual Evaluation: Admin Review & Team Commits
  adminScore           Float?           // Final overridden score if modified
  finalScore           Float?           // Official marks (adminScore ?? aiScore)
  adminFeedback        String?          @db.Text // Official team commit/review feedback
  reviewedByAdminId    String?
  reviewedAt           DateTime?

  submittedAt          DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId])
  @@index([assignmentId])
  @@index([status])
  @@index([userId, weekNumber])
  @@map("assignment_submissions")
}

model StudentMeritScore {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentMarks      Float    @default(0.0)
  quizMarks            Float    @default(0.0)
  progressMarks        Float    @default(0.0)
  consistencyMarks     Float    @default(0.0)
  totalMeritScore      Float    @default(0.0) // CMS composite score (0-100)
  currentRank          Int      @default(0)
  isTopper             Boolean  @default(false)
  topperBadge          String?  // "GOLD", "SILVER", "BRONZE"
  lastCalculatedAt     DateTime @default(now())

  @@index([totalMeritScore(sort: Desc)])
  @@map("student_merit_scores")
}

model InternshipReward {
  id                   String   @id @default(uuid())
  companyName          String
  roleTitle            String
  location             String
  stipendRange         String
  eligibilityCrest     String   // "GOLD", "SILVER", "BRONZE", "TOP_10"
  applyUrl             String?
  referralContact      String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@map("internship_rewards")
}

// ── 20. College / Institutional Campus Model (Campus OS) ──────
model College {
  id                      String    @id @default(uuid())
  name                    String
  slug                    String    @unique
  aisheCode               String    @unique // e.g. C-41234
  aicteCode               String?
  domain                  String    @unique // e.g. raisoni.net, coep.ac.in
  website                 String?
  state                   String    @default("Maharashtra")
  city                    String    @default("Pune")
  affiliatedTo            String?   // e.g. SPPU, DBATU
  naacGrade               String?   @default("A+")
  nirfBand                String?   @default("Top 100")
  logoUrl                 String?
  inviteCode              String    @unique // e.g. COEP2026 for student batch onboarding
  isVerified              Boolean   @default(false)
  verifiedAt              DateTime?
  verificationDocumentUrl String?
  tpoUserId               String?   @unique

  // Relations
  tpoUser                 User?     @relation("CollegeTpo", fields: [tpoUserId], references: [id])
  students                User[]    @relation("CollegeStudents")

  // Telemetry & Aggregation Cache
  studentCount            Int       @default(0)
  avgPlacementScore       Float     @default(78.5)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([aisheCode])
  @@index([domain])
  @@index([inviteCode])
  @@map("colleges")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}
