{
  "name": "disheera-server",
  "version": "1.0.0",
  "description": "Disheera — Backend API server built with Node.js and Express.js",
  "main": "server.js",
  "scripts": {
    "build": "prisma generate",
    "start": "node server.js",
    "postinstall": "prisma generate",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "node --check server.js && node --check seed.js",
    "test:youtube": "node tests/youtube_chamber_test.js",
    "test:video": "node tests/e2e_video_routes_test.js",
    "test:security": "node test_security_suite.js",
    "test:stream": "node test_stream_isolation.js",
    "test:resume": "node test_single_resume.js",
    "test:route": "node test_single_route.js",
    "test:hardened": "node tests/single_route_verification.js",
    "test:track-switcher": "node ../tests/roadmap_completed_track_switcher_test.js",
    "test:recruiter": "node ../tests/recruiter_verification_e2e_test.js",
    "test:rbac": "node ../tests/portal_isolation_rbac_test.js",
    "test:supabase": "node tests/supabase_migration_verification.js",
    "migrate:roadmaps": "node scripts/migrate_roadmaps_active_index.js",
    "whatsapp:bot": "node scripts/openwa_bot_runner.js",
    "test:whatsapp": "node tests/whatsapp_automation_test.js",
    "seed:admin": "node prisma/seedAdmin.js",
    "admin:unlock": "node scripts/unlockAdmin.js",
    "lint": "node --check server.js && node --check seed.js",
    "test:assignments": "node ../tests/assignment_phase1_verification_test.js",
    "seed:assignments": "node prisma/seedAssignments.js",
    "test:assignments-phase2": "node ../tests/assignment_phase2_verification_test.js",
    "test:assignments-phase3": "node ../tests/admin_assignments_phase3_verification_test.js",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "worker:run-now": "node worker.js --run-now"
  },
  "keywords": [
    "careerpath",
    "ai",
    "career-guidance",
    "edtech",
    "career-atlas"
  ],
  "author": "Disheera Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "node-edge-tts": "^1.2.11",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
