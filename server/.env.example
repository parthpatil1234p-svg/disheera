# ============================================================
# CareerPath AI — Backend Environment Configuration Example
# Hack2Ignite 2026–27 · Team: 404 Brain Not Found
# ============================================================
# Copy this file to .env before starting the server:
# cp .env.example .env
# ============================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/careerpath-ai?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5500
