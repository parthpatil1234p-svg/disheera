# ============================================================
# CareerPath AI — Backend Environment Variables
# ============================================================
#
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to Git (it is in .gitignore)
#
# ============================================================

# Server Port
# The port Express will listen on.
# On Render, this is automatically set by the platform.
PORT=5000

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.mongodb.net/careerpathDB?retryWrites=true&w=majority

# JWT Secret Key
# Use a long, random string — at least 32 characters.
# Example: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_long_random_secret_string

# JWT Token Expiry
# How long a login token stays valid.
# Examples: 7d (7 days), 24h (24 hours), 30d
JWT_EXPIRES_IN=7d

# Node Environment
# Use 'development' locally, 'production' on Render.
NODE_ENV=development

# ============================================================
# OPTIONAL — Add these in Step 5+ (Advanced Features)
# ============================================================

# Gemini AI API Key (for AI chatbot / roadmap suggestions)
# Get from: https://ai.google.dev/
# GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (for resume file uploads)
# Get from: https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS in production)
# Replace with your actual Vercel URL after deployment
# CLIENT_URL=https://your-app.vercel.app
