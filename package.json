{
  "name": "disheera",
  "version": "1.0.0",
  "private": true,
  "description": "Disheera — Autonomous AI Career Guidance and Skill Roadmap Platform",
  "scripts": {
    "start": "node scripts/start-all.js",
    "dev": "npm --prefix server run dev",
    "build": "echo 'Client static assets and server ready for production.'",
    "test": "node --check server/server.js && node --check server/seed.js",
    "test:hardened": "node server/tests/single_route_verification.js",
    "test:track-switcher": "node tests/roadmap_completed_track_switcher_test.js",
    "test:recruiter": "node tests/recruiter_verification_e2e_test.js",
    "test:rbac": "node tests/portal_isolation_rbac_test.js",
    "test:supabase": "npm --prefix server run test:supabase",
    "lint": "node --check server/server.js && node --check server/seed.js",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:seed": "npm --prefix server run seed",
    "whatsapp:bot": "npm --prefix server run whatsapp:bot",
    "client:serve": "echo Serving client on http://localhost:5500... && npx --yes serve client -p 5500",
    "admin:serve": "serve admin-client -p 5501",
    "seed:admin": "node server/prisma/seedAdmin.js",
    "seed:team-admins": "node server/scripts/seedTeamAdmins.js",
    "admin:unlock": "node server/scripts/unlockAdmin.js",
    "test:admin-isolation": "node tests/admin_subdomain_isolation_test.js",
    "test:admin-phase2": "node tests/admin_phase2_verification_test.js",
    "test:email": "node server/scripts/testEmail.js",
    "test:assignments": "node tests/assignment_phase1_verification_test.js",
    "seed:assignments": "node server/prisma/seedAssignments.js",
    "test:assignments-phase2": "node tests/assignment_phase2_verification_test.js",
    "test:assignments-phase3": "node tests/admin_assignments_phase3_verification_test.js"
  },
  "keywords": [
    "careerpath",
    "ai",
    "career-guidance",
    "edtech",
    "career-atlas",
    "roadmap"
  ],
  "author": "Disheera Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/server": "^1.9.1",
    "@vercel/analytics": "^2.0.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "serve": "14.2.4"
  }
}
