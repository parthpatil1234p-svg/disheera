# Disheera Standalone Voice AI Service Environment Configuration
PORT=5001
NODE_ENV=production

# Server-Side Secure API Keys (NEVER exposed to frontend browsers)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Shared JWT Secret (must match Disheera main server JWT_SECRET)
JWT_SECRET=your_main_server_jwt_secret_here

# Main Disheera Platform Backend URL (for ticket creation and WhatsApp notifications)
MAIN_API_URL=https://disheera.site/api

# Strict Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://disheera.site,https://www.disheera.site,https://admin.disheera.site,http://localhost:5000,http://localhost:3000
